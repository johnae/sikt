# Rows from `ps`, `ps a` and `ps aux`. Headers drop out: PID isn't an integer.
let field = 1+ none of " "
let gap   = 1+ space
let state = 1+ one of (letter "<+")     # Ss, R+, S<l: never digits

let aux   = user: field gap pid: integer gap cpu: number gap mem: number gap
            vsz: integer gap rss: integer gap tty: field gap stat: state gap
            start: field gap time: field gap
let a     = pid: integer gap tty: field gap stat: state gap time: field gap
let plain = pid: integer gap tty: field gap time: field gap

find line start optional gap (aux or a or plain) command: until text end